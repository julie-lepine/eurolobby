# ============================================================
# EuroLobby — variables d'environnement (Vite)
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# --- Supabase (obligatoire pour Phase 3) ---
# Dashboard : https://supabase.com/dashboard → ton projet → Settings → API

# URL du projet (Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique « anon » (safe côté navigateur, avec RLS activé)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ NE JAMAIS mettre la service_role key dans le front (secret serveur uniquement)
# SUPABASE_SERVICE_ROLE_KEY=  → réservé Edge Functions / backend

# --- Optionnel ---
# VITE_APP_URL=http://localhost:5173
